{
  "name": "free_mind_map",
  "version": "1.0.2",
  "description": "Free Mind Map - 一个开源、免费、跨平台的思维导图软件（基于 Electron）",
  "main": "main.js",
  "author": "hupingin",
  "license": "MIT",
  "homepage": "https://github.com/hupingin/free_mind_map",
  "repository": {
    "type": "git",
    "url": "https://github.com/hupingin/free_mind_map.git"
  },
  "keywords": [
    "mindmap",
    "mind-map",
    "思维导图",
    "electron",
    "outline",
    "free"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "test": "node test/render-smoke.js"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.freemindmap.app",
    "productName": "Free Mind Map",
    "copyright": "Copyright © 2026 hupingin",
    "electronVersion": "30.5.1",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "dir", "arch": "x64" },
        { "target": "portable", "arch": "x64" }
      ],
      "artifactName": "Free-Mind-Map-${version}-portable.exe",
      "publisherName": "hupingin"
    },
    "portable": {
      "artifactName": "Free-Mind-Map-${version}-portable.exe"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
